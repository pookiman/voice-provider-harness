# The names of the keys the adapters read from the shell's environment. This file lists names only:
# never fill it in, and never keep a key in any file. Set each one in your shell for the session.
GEMINI_API_KEY=
OPENAI_API_KEY=
SONIOX_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_ENDPOINT=
ANTHROPIC_API_KEY=
# Any other OpenAI-compatible endpoint's key, named with --key-env, e.g.:
GROQ_API_KEY=
